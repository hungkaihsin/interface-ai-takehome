                "kind": "role_name",
                "role": "textbox",
                "name": "Member Number",
                "name_match": "exact"
              },
              {
                "kind": "role_in_container",
                "role": "textbox",
                "container": {
                  "role": "row",
                  "name": "Member Number",
                  "name_match": "contains",
                  "index": null
                },
                "index": null
              }
            ],
            "describes": "the Member Number input on the inquiry screen"
          }
        },
        "description": "The inquiry form is on screen.",
        "timeout_ms": 5000
      }
    },
    {
      "id": "s2",
      "intent": "Type the member number into the Member Number field.",
      "action": {
        "kind": "fill",
        "target": {
          "frame_path": [
            "main"
          ],
          "strategies": [
            {
              "kind": "role_name",
              "role": "textbox",
              "name": "Member Number",
              "name_match": "exact"
            },
            {
              "kind": "role_in_container",
              "role": "textbox",
              "container": {
                "role": "row",
                "name": "Member Number",
                "name_match": "contains",
                "index": null
              },
              "index": null
            }
          ],
          "describes": "the Member Number input on the inquiry screen"
        },
        "value": "{{ member_id }}"
      },
      "risk": "safe",
      "checkpoint": null
    },
    {
      "id": "s3",
      "intent": "Submit the search.",
      "action": {
        "kind": "click",
        "target": {
          "frame_path": [
            "main"
          ],
          "strategies": [
            {
              "kind": "role_name",
              "role": "button",
              "name": "Search",
              "name_match": "exact"
            }
          ],
          "describes": "the Search button on the inquiry screen"
        }
      },
      "risk": "safe",
      "checkpoint": null
    }
  ],
  "success": {
    "condition": {
      "kind": "element_present",
      "locator": {
        "frame_path": [
          "main"
        ],
        "strategies": [
