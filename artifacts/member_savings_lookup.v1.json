{
  "schema_version": "1.0",
  "capability_id": "member_savings_lookup",
  "version": 1,
  "name": "Look up a member's savings balance",
  "description": "Given a member number, open that member's record in the MeridianCU back-office console and return the current balance of their primary savings account.",
  "surface": {
    "kind": "web",
    "app_id": "meridian-backoffice-v4",
    "tenant_id": "meridian-cu",
    "entry_url": "http://127.0.0.1:5001/shell"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "description": "The member number as printed on the member's card.",
      "required": true,
      "pattern": "^\\d{5}$",
      "example": "10001",
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "savings_balance",
      "type": "money",
      "description": "Current balance of the member's primary savings account.",
      "source": {
        "locator": {
          "frame_path": [
            "main"
          ],
          "strategies": [
            {
              "kind": "role_in_container",
              "role": "cell",
              "container": {
                "role": "row",
                "name": "SAVINGS",
                "name_match": "contains",
                "index": 0
              },
              "index": 2
            }
          ],
          "describes": "the Current Balance cell of the SAVINGS row"
        },
        "transform": [
          {
            "kind": "strip",
            "pattern": null
          },
          {
            "kind": "to_number",
            "pattern": null
          }
        ]
      },
      "required": true,
      "sensitive": false
    }
  ],
  "steps": [
