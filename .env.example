# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Required for DISCOVERY only -- the LLM-driven run that records a new capability.
# Free key: https://aistudio.google.com/apikey
#
# Deterministic replay does NOT read this, or any other key. That is the design
# claim, and you can check it:
#     env -u GOOGLE_API_KEY .venv/bin/python -m scripts.demo_replay --all
GOOGLE_API_KEY=

# Optional. Credentials for the local mock back-office app. These defaults are the
# fake test login printed on the app's own sign-on screen. Credentials live here
# rather than in an artifact so that a saved capability stays portable and
# reviewable -- see surface/session.py.
TARGET_APP_USER=operator
TARGET_APP_PASSWORD=letmein

# Optional. Fixes the mock app's session-signing key across restarts.
TARGET_APP_SECRET=
